#!/usr/bin/env python3
"""Install prebuilt TradeClimb and a private-LAN HTTPS proxy as user services."""
import argparse
import datetime
import ipaddress
import os
import pathlib
import shutil
import ssl
import subprocess

ROOT = pathlib.Path(__file__).resolve().parent.parent
parser = argparse.ArgumentParser(description=__doc__)
parser.add_argument('--lan-ip', required=True)
parser.add_argument('--lan-cidr', required=True)
parser.add_argument('--hostname', default='buntubox1')
args = parser.parse_args()
ip = ipaddress.IPv4Address(args.lan_ip)
network = ipaddress.IPv4Network(args.lan_cidr)
assert ip in network and network.is_private, 'Use a private LAN subnet containing the host IP'
assert all(c.isalnum() or c in '.-' for c in args.hostname), 'Invalid hostname'
home = pathlib.Path.home()
assert not any(c.isspace() or c in '"%\\' for c in str(home)), 'Unsupported home path'
assert (ROOT / 'target/release/tc').is_file() and (ROOT / 'dist/index.html').is_file(), 'Build tc and web assets first'
assert pathlib.Path('/usr/sbin/nginx').is_file(), 'Install the distribution nginx package first'
assert subprocess.check_output(['loginctl', 'show-user', str(os.getuid()), '-p', 'Linger', '--value'], text=True).strip() == 'yes', 'Enable loginctl linger for this user first'
os.umask(0o077)
base = home / '.local/lib/tradeclimb'
config = home / '.config/tradeclimb'
data = home / '.local/share/tradeclimb'
units = home / '.config/systemd/user'
for directory in (base / 'releases', config, data, units):
    directory.mkdir(parents=True, exist_ok=True)
sha = subprocess.check_output(['git', 'rev-parse', '--short', 'HEAD'], cwd=ROOT, text=True).strip()
stamp = datetime.datetime.now(datetime.UTC).strftime('%Y%m%dT%H%M%SZ')
release = base / 'releases' / f'{stamp}-{sha}'
release.mkdir()
shutil.copy2(ROOT / 'target/release/tc', release / 'tc')
shutil.copytree(ROOT / 'dist', release / 'dist')
(release / 'sdk').mkdir()
for name in ('Cargo.toml', 'Cargo.lock', 'rust-toolchain.toml'):
    shutil.copy2(ROOT / name, release / 'sdk' / name)
for name in ('tc-core', 'tc-sdk'):
    shutil.copytree(ROOT / 'crates' / name, release / 'sdk/crates' / name)
(release / 'scripts').mkdir()
shutil.copy2(ROOT / 'scripts/service-ops.py', release / 'scripts/service-ops.py')
revision = subprocess.check_output(['git', 'rev-parse', 'HEAD'], cwd=ROOT, text=True)
dirty = bool(subprocess.check_output(['git', 'status', '--porcelain'], cwd=ROOT, text=True))
(release / 'source.txt').write_text(revision + ('dirty\n' if dirty else ''))
hosts = [args.hostname, args.hostname + '.local', str(ip), 'localhost']
if not (config / 'lan.crt').exists():
    subprocess.run(['openssl', 'req', '-x509', '-newkey', 'rsa:3072', '-nodes', '-days', '365',
                    '-keyout', str(config / 'lan.key'), '-out', str(config / 'lan.crt'),
                    '-subj', f'/CN={args.hostname}', '-addext',
                    f'subjectAltName=DNS:{args.hostname},DNS:{args.hostname}.local,DNS:localhost,IP:{ip},IP:127.0.0.1'],
                   check=True, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
# Refuse to deploy with an existing certificate that doesn't cover this LAN IP.
certificate = ssl._ssl._test_decode_cert(str(config / 'lan.crt'))
assert ('IP Address', str(ip)) in certificate['subjectAltName'], 'Existing certificate does not cover the LAN IP; renew it first'
current = base / 'current'
values = {'HOME': home, 'RELEASE': current, 'CONFIG': config, 'DATA': data,
          'HOSTS': ','.join(hosts), 'SERVER_NAMES': ' '.join(hosts),
          'LAN_CIDR': network, 'RUNTIME': f'/run/user/{os.getuid()}'}
for template in (ROOT / 'deploy').iterdir():
    text = template.read_text()
    for key, value in values.items():
        text = text.replace('@' + key + '@', str(value))
    destination = config / template.name if template.name == 'nginx.conf' else units / template.name
    destination.write_text(text)
# Validate the proxy before switching binaries or restarting the live service.
runtime = pathlib.Path(values['RUNTIME']) / 'tradeclimb-proxy'
runtime.mkdir(exist_ok=True)
subprocess.run(['/usr/sbin/nginx', '-t', '-c', str(config / 'nginx.conf')], check=True)
pending = base / 'current.new'
pending.unlink(missing_ok=True)
pending.symlink_to(release)
pending.replace(current)
subprocess.run(['systemctl', '--user', 'daemon-reload'], check=True)
subprocess.run(['systemctl', '--user', 'enable', 'tradeclimb.service', 'tradeclimb-lan.service',
                'tradeclimb-backup.timer', 'tradeclimb-health.timer'], check=True)
subprocess.run(['systemctl', '--user', 'restart', 'tradeclimb.service', 'tradeclimb-lan.service',
                'tradeclimb-backup.timer', 'tradeclimb-health.timer'], check=True)
print(f'Installed {release}\nLAN: https://{ip}:8443\nData: {data}\nCertificate: {config / "lan.crt"}')
